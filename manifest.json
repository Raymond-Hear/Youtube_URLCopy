{
  "manifest_version": 3,
  "name": "多平台视频链接分批复制",
  "version": "2.0.0",
  "description": "在 YouTube、B站、抖音和小红书页面内分批复制视频链接，并支持选择与导出。",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://search.bilibili.com/*",
    "https://www.douyin.com/*",
    "https://douyin.com/*",
    "https://www.xiaohongshu.com/*",
    "https://xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "复制下一批视频链接",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "commands": {
    "copy-next-batch": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "复制或确认当前平台的下一批视频链接"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://search.bilibili.com/*",
        "https://www.douyin.com/*",
        "https://douyin.com/*",
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/platforms.js",
        "src/youtube-data.js",
        "src/collector.js"
      ],
      "css": [
        "src/page-button.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
