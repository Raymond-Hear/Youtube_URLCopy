{
  "manifest_version": 3,
  "name": "YouTube 链接分批复制",
  "version": "1.4.0",
  "description": "在 YouTube 页面内分批复制视频链接，可选仅链接或标题加链接格式，每批 10、25 或 50 条。",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "复制下一批 YouTube 视频链接",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/youtube-data.js",
        "src/collector.js"
      ],
      "css": [
        "src/page-button.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
